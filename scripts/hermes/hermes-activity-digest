#!/usr/bin/env python3
"""Gera um digest de atividade e envia para o Hermes na racknerd.

Le git log dos repos, os relatorios do fluxo eventually, o estado dos posts e o
material de curriculo/vagas. O Hermes usa isso para rascunhar posts e avaliar
vagas. O notebook e a fonte de verdade. Quando ele esta desligado, o ultimo
pacote sincronizado continua valendo.
"""
from __future__ import annotations

import io
import os
import re
import subprocess
import sys
import tarfile
import time
from datetime import datetime
from pathlib import Path

HOME = Path.home()
AGRO = HOME / "agromercantil"
DAYS = int(os.environ.get("HERMES_ACTIVITY_DAYS", "21"))
REMOTE = os.environ.get("HERMES_ACTIVITY_REMOTE", "htr@racknerd")
MAX_BYTES = 40_000
JOB_QUERIES = os.environ.get("HERMES_JOB_QUERIES", "platform engineer,sre,devops")


def run(args: list[str], cwd: Path | None = None, timeout: int = 30) -> str:
    try:
        out = subprocess.run(
            args,
            cwd=str(cwd) if cwd else None,
            check=True,
            text=True,
            capture_output=True,
            timeout=timeout,
        )
        return out.stdout.strip()
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError):
        return ""


def find_repos() -> list[Path]:
    roots = [HOME / "homelab", HOME / "tcc", HOME / "desafio-platform", HOME / "pyatiletka"]
    found: list[Path] = []
    seen: set[Path] = set()

    def add(path: Path) -> None:
        if path in seen:
            return
        if (path / ".git").exists():
            seen.add(path)
            found.append(path)

    for root in roots:
        add(root)
    for base in (HOME / "gitops-platform", AGRO):
        if not base.is_dir():
            continue
        for dirpath, dirnames, _ in os.walk(base):
            depth = len(Path(dirpath).relative_to(base).parts)
            if depth >= 3:
                dirnames[:] = []
                continue
            dirnames[:] = [
                d for d in dirnames
                if d not in {".git", "node_modules", "worktrees", "archive", "bench-plugins", "curriculos", "linkedin-posts", ".eventually"}
            ]
            add(Path(dirpath))
    return found


def repo_section(repo: Path) -> str:
    log = run([
        "git", "-C", str(repo), "log", f"--since={DAYS} days ago",
        "-i", "--author=heitor", "--date=short",
        "--pretty=format:%h%x09%ad%x09%s", "-n", "12",
    ])
    status = run(["git", "-C", str(repo), "status", "--short"])
    branch = run(["git", "-C", str(repo), "branch", "--show-current"]) or "?"
    remote = run(["git", "-C", str(repo), "remote", "get-url", "origin"])
    remote = re.sub(r"(https?://)[^@/]+@", r"\1", remote)
    if not log and not status:
        return ""
    name = str(repo).replace(str(HOME) + "/", "")
    lines = [f"### {name}", f"- branch: {branch}"]
    if remote:
        lines.append(f"- remote: {remote}")
    if log:
        lines.append("- commits recentes:")
        for row in log.splitlines():
            lines.append(f"  - {row}")
    if status:
        lines.append("- mudancas nao commitadas:")
        for row in status.splitlines()[:12]:
            lines.append(f"  - {row}")
    return "\n".join(lines)


def eventually_section() -> str:
    base = AGRO / ".eventually"
    if not base.is_dir():
        return ""
    files = sorted(base.glob("*.md"), key=lambda p: p.stat().st_mtime, reverse=True)[:2]
    if not files:
        return ""
    blocks = ["## Relatorios eventually"]
    for path in files:
        text = path.read_text(errors="replace")[:6000]
        blocks.append(f"### {path.name}\n\n{text}")
    return "\n\n".join(blocks)


def posts_state() -> str:
    base = AGRO / "linkedin-posts"
    if not base.is_dir():
        return ""
    estado = base / "ESTADO.md"
    text = estado.read_text(errors="replace")[:5000] if estado.exists() else ""
    names = sorted(p.name for p in base.glob("*.md") if p.name not in {"AGENTS.md", "ESTADO.md"})
    blocks = ["## Posts existentes"]
    if text:
        blocks.append(text)
    if names:
        blocks.append("Arquivos: " + ", ".join(names))
    return "\n\n".join(blocks)


def job_search() -> str:
    script = HOME / "homelab/scripts/vagas-buscar"
    if not script.exists():
        return ""
    blocks = [f"# Busca de vagas\n\nGerado em {datetime.now().strftime('%Y-%m-%d %H:%M')}."]
    for query in [q.strip() for q in JOB_QUERIES.split(",") if q.strip()][:3]:
        try:
            result = subprocess.run(
                [str(script), query, "--location", "Brazil", "--limit", "8"],
                text=True,
                capture_output=True,
                timeout=120,
            )
        except subprocess.TimeoutExpired:
            blocks.append(f"## {query}\n\nfalhou: tempo esgotado")
            continue
        if result.stdout.strip():
            blocks.append(result.stdout.strip())
        elif result.stderr.strip():
            blocks.append(f"## {query}\n\nfalhou: {result.stderr.strip()[:200]}")
    return "\n\n".join(blocks)


def career_files() -> dict[str, str]:
    files: dict[str, str] = {}
    base = AGRO / "curriculos"
    if not base.is_dir():
        return files

    def add(arcname: str, path: Path, limit: int = 30000) -> None:
        if path.is_file():
            files[arcname] = path.read_text(errors="replace")[:limit]

    add("vagas/curriculo-base.md", base / "base/heitor_freitas_ferreira.md")
    add("vagas/curriculo-base.en.md", base / "base/heitor_freitas_ferreira.en.md")
    add("vagas/regras-curriculo.md", base / "AGENTS.md", 10000)
    add("vagas/ESTADO.md", base / "ESTADO.md", 10000)
    add("vagas/triagem.md", base / "vagas/_triagem-grupo-whatsapp-2026-10-19.md", 20000)
    add("vagas/cv.css", base / "cv.css", 10000)

    descriptions = sorted(
        (base / "vagas").glob("*/vaga.md"),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )[:20]
    listing = ["# Vagas no workspace"]
    for path in descriptions:
        text = path.read_text(errors="replace")
        slug = path.parent.name
        files[f"vagas/descricoes/{slug}.md"] = text[:8000]
        title = next((line.lstrip("# ").strip() for line in text.splitlines() if line.strip()), slug)
        link = next((line.split(":", 1)[1].strip() for line in text.splitlines() if line.lower().startswith("- link:")), "")
        listing.append(f"- {title} ({slug})" + (f": {link}" if link else ""))
    files["vagas/lista.md"] = "\n".join(listing)

    derived = sorted(
        (base / "vagas").glob("*/heitor_freitas_ferreira.*.md"),
        key=lambda p: p.stat().st_mtime,
        reverse=True,
    )[:30]
    for path in derived:
        files[f"vagas/derivadas/{path.parent.name}/{path.name}"] = path.read_text(errors="replace")[:30000]

    search = job_search()
    if search:
        files["vagas/buscas/latest.md"] = search[:30000]
    return files


def main() -> int:
    sections = [
        "# Digest de atividade para LinkedIn e vagas",
        f"Gerado em {datetime.now().strftime('%Y-%m-%d %H:%M')}.",
        f"Janela: ultimos {DAYS} dias.",
    ]
    repo_blocks = [s for repo in find_repos() if (s := repo_section(repo))]
    if repo_blocks:
        sections.append("## Repositorios\n\n" + "\n\n".join(repo_blocks))
    for extra in (eventually_section(), posts_state()):
        if extra:
            sections.append(extra)

    digest = "\n\n".join(sections).strip() + "\n"
    if len(digest.encode()) > MAX_BYTES:
        digest = digest.encode()[:MAX_BYTES].decode(errors="replace") + "\n\n[truncado]\n"

    files = {"linkedin/latest.md": digest}
    files.update(career_files())

    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w:gz") as tar:
        for arcname, content in files.items():
            data = content.encode("utf-8")
            info = tarfile.TarInfo(arcname)
            info.size = len(data)
            info.mtime = int(time.time())
            tar.addfile(info, io.BytesIO(data))

    remote_cmd = (
        "mkdir -p ~/.hermes/linkedin ~/.hermes/vagas/buscas ~/.hermes/vagas/descricoes && "
        "tar -xzf - -C ~/.hermes"
    )
    result = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", REMOTE, remote_cmd],
        input=buffer.getvalue(),
        capture_output=True,
    )
    if result.returncode != 0:
        sys.stderr.write(result.stderr.decode(errors="replace"))
        return 1

    print(
        f"pacote enviado: {len(buffer.getvalue())} bytes, "
        f"{len(repo_blocks)} repos, {len(files)} arquivos"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
