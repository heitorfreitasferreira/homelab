[Unit]
Description=Reinicia o hermes-gateway (recarrega os MCPs stdio)
# Fica fora do cgroup do gateway: o Hermes pode disparar este servico e o
# restart continua mesmo depois que o processo dele morrer.

[Service]
Type=oneshot
# Espera para o Hermes terminar de responder no Telegram antes de cair.
ExecStartPre=/bin/sleep 20
ExecStart=/bin/systemctl restart hermes-gateway.service
