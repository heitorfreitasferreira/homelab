#!/usr/bin/env python3
"""Busca vagas em fontes publicas e imprime um resumo em Markdown ou JSON.

Fontes: LinkedIn guest, LinkedIn pelo Chrome do notebook, Remotive, RemoteOK,
We Work Remotely, Adzuna, Jooble, SerpApi Google Jobs e grupos do WhatsApp pelo
WAHA. As fontes com chave leem ~/.hermes/vagas/api.env. Nao aplica em vaga
nenhuma. So coleta e ordena.
"""
from __future__ import annotations

import argparse
import html
import json
import os
import re
import sys
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime, timedelta, timezone
from pathlib import Path

UA = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/159.0.0.0 Safari/537.36"
)

KEYWORDS = {
    "kubernetes": 3,
    "k8s": 3,
    "terraform": 2,
    "opentofu": 2,
    "argocd": 2,
    "argo cd": 2,
    "gitops": 2,
    "ci/cd": 2,
    "cicd": 2,
    "observability": 2,
    "observabilidade": 2,
    "platform engineer": 2,
    "platform engineering": 2,
    "sre": 2,
    "site reliability": 2,
    "devops": 2,
    "prometheus": 1,
    "grafana": 1,
    "opentelemetry": 1,
    "postgresql": 1,
    "postgres": 1,
    "python": 1,
    "golang": 1,
    "go ": 1,
    "aws": 1,
    "docker": 1,
    "helm": 1,
    "linux": 1,
    "remote": 1,
    "remoto": 1,
}


def fetch(url: str, timeout: int = 25) -> bytes:
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": UA,
            "Accept": "application/json, text/html, application/xml, text/xml, */*",
            "Accept-Language": "pt-BR,pt,en-US,en",
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as response:
        return response.read()


def clean(value: str | None) -> str:
    if not value:
        return ""
    value = re.sub(r"<[^>]+>", " ", value)
    value = html.unescape(value)
    return re.sub(r"\s+", " ", value).strip()


def score(title: str, description: str = "", tags: list[str] | None = None) -> int:
    text = " ".join([title, description, " ".join(tags or [])]).lower()
    return sum(weight for word, weight in KEYWORDS.items() if word in text)


def parse_date(value: str) -> str:
    if not value:
        return ""
    value = value.strip()
    for fmt in ("%Y-%m-%dT%H:%M:%S", "%Y-%m-%d", "%a, %d %b %Y %H:%M:%S %z"):
        try:
            return datetime.strptime(value[: len(fmt) + 8], fmt).strftime("%Y-%m-%d")
        except ValueError:
            continue
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).strftime("%Y-%m-%d")
    except ValueError:
        return value[:10]


def recent(date_str: str, days: int) -> bool:
    if not date_str:
        return True
    try:
        date = datetime.strptime(date_str, "%Y-%m-%d").date()
    except ValueError:
        return True
    return date >= (datetime.now(timezone.utc).date() - timedelta(days=days))


def linkedin(query: str, location: str, limit: int, days: int) -> list[dict]:
    jobs: list[dict] = []
    seen: set[str] = set()
    for start in range(0, min(limit, 50), 25):
        params = urllib.parse.urlencode(
            {
                "keywords": query,
                "location": location,
                "start": start,
                "f_TPR": f"r{days * 86400}",
            }
        )
        raw = fetch(f"https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?{params}")
        page = raw.decode("utf-8", "replace")
        for block in re.findall(r"<li>(.*?)</li>", page, re.S):
            link_match = re.search(r'base-card__full-link[^>]*href="([^"]+)"', block)
            if not link_match:
                continue
            link = html.unescape(link_match.group(1)).split("?")[0]
            if link in seen:
                continue
            title = clean(re.search(r"base-search-card__title[^>]*>(.*?)</h3>", block, re.S).group(1)
                          if re.search(r"base-search-card__title[^>]*>(.*?)</h3>", block, re.S) else "")
            company = clean(re.search(r"base-search-card__subtitle[^>]*>(.*?)</h4>", block, re.S).group(1)
                            if re.search(r"base-search-card__subtitle[^>]*>(.*?)</h4>", block, re.S) else "")
            loc = clean(re.search(r"job-search-card__location[^>]*>(.*?)</span>", block, re.S).group(1)
                        if re.search(r"job-search-card__location[^>]*>(.*?)</span>", block, re.S) else "")
            date_match = re.search(r'<time[^>]*datetime="([^"]+)"', block)
            date = parse_date(date_match.group(1) if date_match else "")
            if not title:
                continue
            seen.add(link)
            jobs.append(
                {
                    "source": "linkedin",
                    "title": title,
                    "company": company,
                    "location": loc,
                    "date": date,
                    "url": link,
                    "score": score(title, "", [loc]),
                }
            )
            if len(jobs) >= limit:
                return jobs
        time.sleep(1)
    return jobs


def remotive(query: str, limit: int, days: int) -> list[dict]:
    data = json.loads(fetch("https://remotive.com/api/remote-jobs?search=" + urllib.parse.quote(query) + "&limit=50"))
    jobs = []
    for item in data.get("jobs", []):
        title = item.get("title", "")
        description = clean(item.get("description", ""))[:2000]
        date = parse_date(item.get("publication_date", ""))
        if not recent(date, days):
            continue
        jobs.append(
            {
                "source": "remotive",
                "title": title,
                "company": item.get("company_name", ""),
                "location": item.get("candidate_required_location", "Remote"),
                "date": date,
                "url": item.get("url", ""),
                "score": score(title, description, item.get("tags", [])),
            }
        )
        if len(jobs) >= limit:
            break
    return jobs


def remoteok(query: str, limit: int, days: int) -> list[dict]:
    data = json.loads(fetch("https://remoteok.com/api?tags=" + urllib.parse.quote(query.replace(" ", "-"))))
    jobs = []
    for item in data:
        if not isinstance(item, dict) or "position" not in item:
            continue
        title = item.get("position", "")
        description = clean(item.get("description", ""))[:2000]
        date = parse_date(str(item.get("date", "")))
        if not recent(date, days):
            continue
        jobs.append(
            {
                "source": "remoteok",
                "title": title,
                "company": item.get("company", ""),
                "location": item.get("location", "Remote"),
                "date": date,
                "url": item.get("url") or f"https://remoteok.com/remote-jobs/{item.get('id', '')}",
                "score": score(title, description, item.get("tags", [])),
            }
        )
        if len(jobs) >= limit:
            break
    return jobs


def wwr(query: str, limit: int, days: int) -> list[dict]:
    feeds = [
        "https://weworkremotely.com/categories/remote-devops-sysadmin-jobs.rss",
        "https://weworkremotely.com/categories/remote-programming-jobs.rss",
    ]
    jobs = []
    for feed in feeds:
        root = ET.fromstring(fetch(feed))
        for item in root.findall("./channel/item"):
            title = (item.findtext("title") or "").strip()
            region = (item.findtext("region") or "Remote").strip()
            description = clean(item.findtext("description") or "")[:2000]
            date = parse_date((item.findtext("pubDate") or "").strip())
            if not recent(date, days):
                continue
            jobs.append(
                {
                    "source": "weworkremotely",
                    "title": title,
                    "company": "",
                    "location": region,
                    "date": date,
                    "url": (item.findtext("link") or "").strip(),
                    "score": score(title, description, []),
                }
            )
            if len(jobs) >= limit:
                return jobs
    return jobs


class SourceUnavailable(RuntimeError):
    pass


def api_keys() -> dict[str, str]:
    keys = dict(os.environ)
    path = Path.home() / ".hermes/vagas/api.env"
    if path.is_file():
        for line in path.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            keys[key.strip()] = value.strip().strip('"').strip("'")
    return keys


def linkedin_browser(query: str, location: str, limit: int, days: int) -> list[dict]:
    try:
        from websockets.sync.client import connect
    except ImportError as exc:
        raise SourceUnavailable("sem python3-websockets") from exc

    cdp = os.environ.get("HERMES_BROWSER_CDP", "http://100.90.131.64:9222").rstrip("/")
    target = "https://www.linkedin.com/jobs/search?" + urllib.parse.urlencode(
        {"keywords": query, "location": location, "f_TPR": f"r{days * 86400}"}
    )
    request = urllib.request.Request(
        cdp + "/json/new?" + urllib.parse.quote(target, safe=""), method="PUT"
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        info = json.load(response)

    def call(ws, ident: int, method: str, params: dict | None = None) -> dict:
        ws.send(json.dumps({"id": ident, "method": method, "params": params or {}}))
        while True:
            message = json.loads(ws.recv(timeout=45))
            if message.get("id") == ident:
                return message

    expression = r"""(() => {
      const seen = new Set();
      const out = [];
      for (const a of document.querySelectorAll('a[href*="/jobs/view/"]')) {
        const url = a.href.split('?')[0];
        if (seen.has(url)) continue;
        seen.add(url);
        const card = a.closest('li') || a.parentElement;
        const pick = (sel) => {
          const el = card && card.querySelector(sel);
          return el ? el.innerText.trim() : "";
        };
        const title = pick('.base-search-card__title, .job-card-list__title, .job-card-container__link')
          || (a.innerText || '').trim();
        const company = pick('.base-search-card__subtitle, .job-card-container__company-name, .job-card-container__primary-description');
        const location = pick('.job-search-card__location, .job-card-container__metadata-item');
        out.push({url, title, company, location});
      }
      return JSON.stringify(out);
    })()"""

    try:
        with connect(info["webSocketDebuggerUrl"], open_timeout=15, close_timeout=5) as ws:
            call(ws, 1, "Page.enable")
            call(ws, 2, "Page.navigate", {"url": target})
            time.sleep(8)
            result = call(
                ws,
                3,
                "Runtime.evaluate",
                {"expression": expression, "returnByValue": True},
            )
            raw = result.get("result", {}).get("result", {}).get("value") or "[]"
            items = json.loads(raw)
    finally:
        try:
            urllib.request.urlopen(cdp + "/json/close/" + info["id"], timeout=10).read()
        except Exception:
            pass

    jobs = []
    for item in items[:limit]:
        title = item.get("title", "")
        url = item.get("url", "")
        if not title or not url:
            continue
        jobs.append(
            {
                "source": "linkedin-browser",
                "title": title,
                "company": item.get("company", ""),
                "location": item.get("location", ""),
                "date": "",
                "url": url,
                "score": score(title, "", [item.get("location", "")]),
            }
        )
    return jobs


def adzuna(query: str, location: str, limit: int, days: int) -> list[dict]:
    keys = api_keys()
    app_id = keys.get("ADZUNA_APP_ID")
    app_key = keys.get("ADZUNA_APP_KEY")
    if not app_id or not app_key:
        raise SourceUnavailable("sem ADZUNA_APP_ID/ADZUNA_APP_KEY")
    country = keys.get("ADZUNA_COUNTRY", "br")
    params = {
        "app_id": app_id,
        "app_key": app_key,
        "results_per_page": limit,
        "what": query,
        "max_days_old": days,
    }
    if location and location.lower() not in ("brazil", "brasil", "remote", "remoto"):
        params["where"] = location
    data = json.loads(fetch(f"https://api.adzuna.com/v1/api/jobs/{country}/search/1?{urllib.parse.urlencode(params)}"))
    jobs = []
    for item in data.get("results", []):
        title = item.get("title", "")
        company = (item.get("company") or {}).get("display_name", "")
        loc = (item.get("location") or {}).get("display_name", "")
        jobs.append(
            {
                "source": "adzuna",
                "title": title,
                "company": company,
                "location": loc,
                "date": parse_date(item.get("created", "")),
                "url": item.get("redirect_url", ""),
                "score": score(title, item.get("description", ""), [loc]),
            }
        )
    return jobs


def jooble(query: str, location: str, limit: int, days: int) -> list[dict]:
    key = api_keys().get("JOOBLE_KEY")
    if not key:
        raise SourceUnavailable("sem JOOBLE_KEY")
    payload = json.dumps({"keywords": query, "location": location}).encode()
    request = urllib.request.Request(
        "https://jooble.org/api/" + key,
        data=payload,
        headers={"Content-Type": "application/json", "User-Agent": UA},
    )
    with urllib.request.urlopen(request, timeout=25) as response:
        data = json.load(response)
    jobs = []
    for item in data.get("jobs", [])[:limit]:
        title = item.get("title", "")
        loc = item.get("location", "")
        jobs.append(
            {
                "source": "jooble",
                "title": title,
                "company": item.get("company", ""),
                "location": loc,
                "date": parse_date(item.get("updated", "")),
                "url": item.get("link", ""),
                "score": score(title, item.get("snippet", ""), [loc]),
            }
        )
    return jobs


def serpapi(query: str, location: str, limit: int, days: int) -> list[dict]:
    key = api_keys().get("SERPAPI_KEY")
    if not key:
        raise SourceUnavailable("sem SERPAPI_KEY")
    params = {
        "engine": "google_jobs",
        "q": query,
        "location": location,
        "api_key": key,
        "hl": "pt",
        "gl": "br",
    }
    data = json.loads(fetch("https://serpapi.com/search.json?" + urllib.parse.urlencode(params)))
    jobs = []
    for item in data.get("jobs_results", [])[:limit]:
        title = item.get("title", "")
        loc = item.get("location", "")
        via = item.get("via", "")
        options = item.get("apply_options") or []
        url = item.get("share_link") or (options[0].get("link") if options else "")
        jobs.append(
            {
                "source": "serpapi",
                "title": title,
                "company": item.get("company_name", "") + (f" ({via})" if via else ""),
                "location": loc,
                "date": "",
                "url": url,
                "score": score(title, item.get("description", ""), [loc, via]),
            }
        )
    return jobs


# WhatsApp pelo WAHA, com chave de sessao somente leitura (WAHA_READ_KEY).
WAHA_URL = "https://waha.tail76c1c6.ts.net"
WAHA_SESSION = "heitor"
WAHA_CHATS = "Dominando Cloud;UberHub Comunidade"
WAHA_PAGE = 200
WAHA_MAX_MESSAGES = 1000  # por chat e por busca
WAHA_MAX_CHATS = 2000
WAHA_SKIP_URLS = ("whatsapp.com", "wa.me/")

URL_RE = re.compile(r"https?://[^\s<>\"']+")
EMAIL_RE = re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+")
ROLE_RE = re.compile(
    r"\b(engineers?|engenheir[oa]s?|analistas?|analysts?|developers?|desenvolvedor(?:a|es)?|"
    r"arquitet[oa]s?|architects?|especialistas?|specialists?|consultor(?:a|es)?|"
    r"administrador(?:a|es)?|sysadmin|devops|devsecops|sre|tech lead|cientistas?|"
    r"scientists?|coordenador(?:a|es)?|gerentes?|managers?|head of)\b"
)
# Ordem importa: hibrido explicito vence, "100% remoto" vence "presencial".
WORK_MODES = (
    ("hibrid", "Híbrido"),
    ("hybrid", "Híbrido"),
    ("100% remot", "Remoto"),
    ("full remote", "Remoto"),
    ("fully remote", "Remoto"),
    ("totalmente remot", "Remoto"),
    ("presencial", "Presencial"),
    ("on-site", "Presencial"),
    ("onsite", "Presencial"),
    ("remot", "Remoto"),
)
QUERY_STOP = {
    "engineer", "engenheiro", "engenheira", "engenharia", "engineering", "analista",
    "analyst", "developer", "desenvolvedor", "senior", "pleno", "junior", "jr", "sr",
    "pl", "de", "da", "do", "em", "and", "or", "the", "of", "vaga", "vagas", "job",
    "jobs", "remote", "remoto", "remota", "site",
}
QUERY_ALIASES = {
    "sre": ["sre", "site reliability", "confiabilidade"],
    "reliability": ["reliability", "confiabilidade", "sre"],
    "devops": ["devops", "dev ops", "devsecops"],
    "platform": ["platform", "plataforma"],
    "plataforma": ["platform", "plataforma"],
    "cloud": ["cloud", "nuvem"],
    "kubernetes": ["kubernetes", "k8s"],
    "k8s": ["kubernetes", "k8s"],
    "infra": ["infra", "infraestrutura", "infrastructure"],
    "infraestrutura": ["infra", "infraestrutura", "infrastructure"],
    "infrastructure": ["infra", "infraestrutura", "infrastructure"],
    "dados": ["dados", "data"],
    "data": ["dados", "data"],
}


def fold(value: str) -> str:
    """Minusculas sem acento. NFKD tambem desfaz o negrito Unicode dos posts."""
    decomposed = unicodedata.normalize("NFKD", value or "")
    return "".join(c for c in decomposed if not unicodedata.combining(c)).lower()


def clean_line(value: str) -> str:
    value = re.sub(r"[*_~`]", "", value)
    value = re.sub(r"^[^\w(]+", "", value.strip())
    return re.sub(r"\s+", " ", value).strip()


def query_terms(query: str) -> list[list[str]]:
    """Grupos de termos. A mensagem bate se tiver qualquer termo de qualquer grupo."""
    groups = []
    for word in re.findall(r"[a-z0-9+#.-]+", fold(query)):
        if len(word) < 2 or word in QUERY_STOP:
            continue
        groups.append(QUERY_ALIASES.get(word, [word]))
    return groups


def has_term(term: str, text: str) -> bool:
    return re.search(r"(?<![a-z0-9])" + re.escape(term) + r"(?![a-z0-9])", text) is not None


def whatsapp_job(message: dict, chat_name: str, terms: list[list[str]]) -> dict | None:
    """Converte um post de vaga em resultado. Conversa, evento e artigo ficam fora."""
    body = str(message.get("body") or "").strip()
    if len(body) < 40:
        return None
    raw = [line.strip() for line in body.splitlines() if line.strip()]
    lines = [clean_line(line) for line in raw]
    title = next((line for line in lines[:3] if line and ROLE_RE.search(fold(line))), "")
    if not title:
        return None
    urls = [u.rstrip(".,;:!?)]") for u in URL_RE.findall(body)]
    urls = [u for u in urls if not any(s in u.lower() for s in WAHA_SKIP_URLS)]
    without_urls = URL_RE.sub(" ", body)
    emails = EMAIL_RE.findall(without_urls)
    if not urls and not emails:
        return None
    folded = fold(without_urls)
    if terms and not any(has_term(term, folded) for group in terms for term in group):
        return None

    company = ""
    place = ""
    for line, text in zip(raw[:10], lines[:10]):
        head = fold(text)
        labeled = head.startswith(("empresa:", "company:"))
        if not company and ("\U0001F3E2" in line[:3] or labeled):
            company = clean_line(text.split(":", 1)[1]) if labeled else text
        labeled = head.startswith(("local:", "localizacao:", "location:", "cidade:"))
        if not place and ("\U0001F4CD" in line[:3] or labeled):
            place = clean_line(text.split(":", 1)[1]) if labeled else text
    if not place:
        match = re.search(r"\(([^()]{2,40})\)\s*$", title)
        place = match.group(1).strip() if match else ""
    mode = next((label for key, label in WORK_MODES if key in folded), "")
    location = place
    if mode and fold(mode)[:5] not in fold(place):
        location = f"{place}, {mode}" if place else mode

    try:
        date = datetime.fromtimestamp(int(float(message.get("timestamp") or 0))).strftime("%Y-%m-%d")
    except (TypeError, ValueError, OSError, OverflowError):
        date = ""
    excerpt = re.sub(r"\s+", " ", body)
    if len(excerpt) > 280:
        excerpt = excerpt[:279].rstrip() + "…"
    return {
        "source": "whatsapp",
        "title": title[:140],
        "company": company[:80],
        "location": location[:80],
        "date": date,
        "url": urls[0] if urls else f"mailto:{emails[0]}",
        "score": score(fold(title), folded, [fold(location)]),
        "group": chat_name,
        "excerpt": excerpt,
    }


def waha_get(base: str, token: str, path: str, params: dict) -> list:
    request = urllib.request.Request(
        f"{base}{path}?{urllib.parse.urlencode(params)}",
        headers={"X-Api-Key": token, "Accept": "application/json", "User-Agent": "vagas-buscar"},
    )
    reasons = {
        401: "chave recusada",
        403: "chave sem permissao de leitura",
        404: "sessao inexistente",
        422: "sessao fora do WORKING",
    }
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            data = json.load(response)
    except urllib.error.HTTPError as exc:
        raise SourceUnavailable(f"WAHA {exc.code}, {reasons.get(exc.code, 'erro')}") from exc
    except urllib.error.URLError as exc:
        raise SourceUnavailable(f"WAHA inacessivel: {exc.reason}") from exc
    except TimeoutError as exc:
        raise SourceUnavailable("WAHA sem resposta em 30 s") from exc
    if not isinstance(data, list):
        raise SourceUnavailable("WAHA respondeu fora do formato esperado")
    return data


def whatsapp(query: str, limit: int, days: int, errors: list[str]) -> list[dict]:
    keys = api_keys()
    token = keys.get("WAHA_READ_KEY", "")
    if not token:
        raise SourceUnavailable("sem WAHA_READ_KEY")
    base = keys.get("WAHA_URL", WAHA_URL).rstrip("/")
    session = urllib.parse.quote(keys.get("WAHA_SESSION", WAHA_SESSION), safe="")
    wanted = [c.strip() for c in keys.get("WAHA_JOB_CHATS", WAHA_CHATS).split(";") if c.strip()]

    # Entrada com @ e id de chat. O resto e trecho do nome, sem caixa e sem acento.
    chats = {c: c for c in wanted if "@" in c}
    patterns = {c: re.sub(r"\s+", " ", fold(c)) for c in wanted if "@" not in c}
    matched: set[str] = set()
    if patterns:
        for offset in range(0, WAHA_MAX_CHATS, WAHA_PAGE):
            page = waha_get(base, token, f"/api/{session}/chats", {"limit": WAHA_PAGE, "offset": offset})
            for chat in page:
                chat_id = str(chat.get("id") or "")
                name = str(chat.get("name") or "")
                folded_name = re.sub(r"\s+", " ", fold(name))
                for label, pattern in patterns.items():
                    if chat_id and pattern in folded_name:
                        chats[chat_id] = name
                        matched.add(label)
            if len(page) < WAHA_PAGE:
                break
    for label in patterns:
        if label not in matched:
            errors.append(f"whatsapp (nenhum chat com '{label}')")
    if not chats:
        raise SourceUnavailable("nenhum chat de WAHA_JOB_CHATS encontrado")

    since = int(time.time()) - days * 86400
    terms = query_terms(query)
    jobs: dict[str, dict] = {}
    for chat_id, name in chats.items():
        path = f"/api/{session}/chats/{urllib.parse.quote(chat_id, safe='')}/messages"
        for offset in range(0, WAHA_MAX_MESSAGES, WAHA_PAGE):
            page = waha_get(
                base,
                token,
                path,
                {"limit": WAHA_PAGE, "offset": offset, "downloadMedia": "false", "filter.timestamp.gte": since},
            )
            for message in page:
                job = whatsapp_job(message, name, terms)
                if job and job["url"] not in jobs:
                    jobs[job["url"]] = job
            if len(page) < WAHA_PAGE:
                break
        else:
            errors.append(f"whatsapp ({name}: so as {WAHA_MAX_MESSAGES} mensagens mais recentes)")
    ranked = sorted(jobs.values(), key=lambda j: (j["score"], j["date"]), reverse=True)
    return ranked[:limit]


def render_markdown(
    query: str, location: str, jobs: list[dict], errors: list[str], sources: list[str]
) -> str:
    lines = [
        f"# Vagas: {query}" + (f" em {location}" if location else ""),
        "",
        f"Gerado em {datetime.now().strftime('%Y-%m-%d %H:%M')}.",
        "Fontes: " + ", ".join(sources) + ".",
        "",
    ]
    if errors:
        lines.append("Fontes indisponiveis: " + ", ".join(errors))
        lines.append("")
    if not jobs:
        lines.append("Nenhuma vaga encontrada nas fontes consultadas.")
        return "\n".join(lines) + "\n"
    for job in jobs:
        lines.append(f"## {job['title']}")
        meta = [job.get("company") or "", job.get("location") or "", job.get("source") or "", job.get("date") or ""]
        lines.append(" | ".join([m for m in meta if m]))
        lines.append(f"- link: {job['url']}")
        if job.get("group"):
            lines.append(f"- grupo: {job['group']}")
        if job.get("excerpt"):
            lines.append(f"- trecho: {job['excerpt']}")
        lines.append(f"- score: {job['score']}")
        lines.append("")
    return "\n".join(lines)


def main() -> int:
    # O WhatsApp entra no padrao onde a chave existe (racknerd), e fica fora no notebook.
    default_sources = "linkedin,remotive,remoteok,wwr"
    if api_keys().get("WAHA_READ_KEY"):
        default_sources += ",whatsapp"
    parser = argparse.ArgumentParser(description="Busca vagas em fontes publicas.")
    parser.add_argument("query", help="cargo ou palavras-chave")
    parser.add_argument("--location", default="Brazil", help="local para o LinkedIn")
    parser.add_argument("--limit", type=int, default=10, help="maximo por fonte")
    parser.add_argument("--days", type=int, default=21, help="janela em dias")
    parser.add_argument(
        "--sources",
        default=default_sources,
        help="linkedin, linkedin-browser, remotive, remoteok, wwr, adzuna, jooble, serpapi, "
        "whatsapp (padrao: " + default_sources + ")",
    )
    parser.add_argument("--json", action="store_true", help="saida JSON")
    parser.add_argument("--out", help="arquivo para salvar o Markdown")
    args = parser.parse_args()

    sources = {s.strip().lower() for s in args.sources.split(",") if s.strip()}
    jobs: list[dict] = []
    errors: list[str] = []
    runners = (
        ("linkedin", lambda: linkedin(args.query, args.location, args.limit, args.days)),
        ("linkedin-browser", lambda: linkedin_browser(args.query, args.location, args.limit, args.days)),
        ("remotive", lambda: remotive(args.query, args.limit, args.days)),
        ("remoteok", lambda: remoteok(args.query, args.limit, args.days)),
        ("wwr", lambda: wwr(args.query, args.limit, args.days)),
        ("adzuna", lambda: adzuna(args.query, args.location, args.limit, args.days)),
        ("jooble", lambda: jooble(args.query, args.location, args.limit, args.days)),
        ("serpapi", lambda: serpapi(args.query, args.location, args.limit, args.days)),
        ("whatsapp", lambda: whatsapp(args.query, args.limit, args.days, errors)),
    )
    selected = [name for name, _ in runners if name in sources]
    for name, func in runners:
        if name not in sources:
            continue
        try:
            jobs.extend(func())
        except SourceUnavailable as exc:
            errors.append(f"{name} ({exc})")
        except Exception as exc:  # noqa: BLE001
            errors.append(f"{name} ({type(exc).__name__})")

    unique: dict[str, dict] = {}
    for job in jobs:
        key = job.get("url") or f"{job.get('title')}|{job.get('company')}"
        if key and key not in unique:
            unique[key] = job
    jobs = sorted(unique.values(), key=lambda j: (j["score"], j.get("date") or ""), reverse=True)

    if args.json:
        output = json.dumps(
            {"query": args.query, "sources": selected, "errors": errors, "jobs": jobs},
            ensure_ascii=False,
            indent=2,
        )
    else:
        output = render_markdown(args.query, args.location, jobs, errors, selected)

    if args.out:
        with open(args.out, "w", encoding="utf-8") as handle:
            handle.write(output)
        print(f"{len(jobs)} vagas salvas em {args.out}")
    else:
        print(output)
    return 0 if jobs else 1


if __name__ == "__main__":
    raise SystemExit(main())
