#!/usr/bin/env python3
"""Busca vagas em fontes publicas e imprime um resumo em Markdown ou JSON.

Fontes: LinkedIn guest, LinkedIn pelo navegador do WSL, Remotive, RemoteOK,
We Work Remotely, Adzuna, Jooble e SerpApi Google Jobs. As fontes com chave leem
~/.hermes/vagas/api.env. Nao aplica em vaga nenhuma. So coleta e ordena.
"""
from __future__ import annotations

import argparse
import html
import json
import os
import re
import sys
import time
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET
from datetime import datetime, timedelta, timezone
from pathlib import Path

UA = (
    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
    "(KHTML, like Gecko) Chrome/159.0.0.0 Safari/537.36"
)

KEYWORDS = {
    "kubernetes": 3,
    "k8s": 3,
    "terraform": 2,
    "opentofu": 2,
    "argocd": 2,
    "argo cd": 2,
    "gitops": 2,
    "ci/cd": 2,
    "cicd": 2,
    "observability": 2,
    "observabilidade": 2,
    "platform engineer": 2,
    "platform engineering": 2,
    "sre": 2,
    "site reliability": 2,
    "devops": 2,
    "prometheus": 1,
    "grafana": 1,
    "opentelemetry": 1,
    "postgresql": 1,
    "postgres": 1,
    "python": 1,
    "golang": 1,
    "go ": 1,
    "aws": 1,
    "docker": 1,
    "helm": 1,
    "linux": 1,
    "remote": 1,
    "remoto": 1,
}


def fetch(url: str, timeout: int = 25) -> bytes:
    req = urllib.request.Request(
        url,
        headers={
            "User-Agent": UA,
            "Accept": "application/json, text/html, application/xml, text/xml, */*",
            "Accept-Language": "pt-BR,pt,en-US,en",
        },
    )
    with urllib.request.urlopen(req, timeout=timeout) as response:
        return response.read()


def clean(value: str | None) -> str:
    if not value:
        return ""
    value = re.sub(r"<[^>]+>", " ", value)
    value = html.unescape(value)
    return re.sub(r"\s+", " ", value).strip()


def score(title: str, description: str = "", tags: list[str] | None = None) -> int:
    text = " ".join([title, description, " ".join(tags or [])]).lower()
    return sum(weight for word, weight in KEYWORDS.items() if word in text)


def parse_date(value: str) -> str:
    if not value:
        return ""
    value = value.strip()
    for fmt in ("%Y-%m-%dT%H:%M:%S", "%Y-%m-%d", "%a, %d %b %Y %H:%M:%S %z"):
        try:
            return datetime.strptime(value[: len(fmt) + 8], fmt).strftime("%Y-%m-%d")
        except ValueError:
            continue
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).strftime("%Y-%m-%d")
    except ValueError:
        return value[:10]


def recent(date_str: str, days: int) -> bool:
    if not date_str:
        return True
    try:
        date = datetime.strptime(date_str, "%Y-%m-%d").date()
    except ValueError:
        return True
    return date >= (datetime.now(timezone.utc).date() - timedelta(days=days))


def linkedin(query: str, location: str, limit: int, days: int) -> list[dict]:
    jobs: list[dict] = []
    seen: set[str] = set()
    for start in range(0, min(limit, 50), 25):
        params = urllib.parse.urlencode(
            {
                "keywords": query,
                "location": location,
                "start": start,
                "f_TPR": f"r{days * 86400}",
            }
        )
        raw = fetch(f"https://www.linkedin.com/jobs-guest/jobs/api/seeMoreJobPostings/search?{params}")
        page = raw.decode("utf-8", "replace")
        for block in re.findall(r"<li>(.*?)</li>", page, re.S):
            link_match = re.search(r'base-card__full-link[^>]*href="([^"]+)"', block)
            if not link_match:
                continue
            link = html.unescape(link_match.group(1)).split("?")[0]
            if link in seen:
                continue
            title = clean(re.search(r"base-search-card__title[^>]*>(.*?)</h3>", block, re.S).group(1)
                          if re.search(r"base-search-card__title[^>]*>(.*?)</h3>", block, re.S) else "")
            company = clean(re.search(r"base-search-card__subtitle[^>]*>(.*?)</h4>", block, re.S).group(1)
                            if re.search(r"base-search-card__subtitle[^>]*>(.*?)</h4>", block, re.S) else "")
            loc = clean(re.search(r"job-search-card__location[^>]*>(.*?)</span>", block, re.S).group(1)
                        if re.search(r"job-search-card__location[^>]*>(.*?)</span>", block, re.S) else "")
            date_match = re.search(r'<time[^>]*datetime="([^"]+)"', block)
            date = parse_date(date_match.group(1) if date_match else "")
            if not title:
                continue
            seen.add(link)
            jobs.append(
                {
                    "source": "linkedin",
                    "title": title,
                    "company": company,
                    "location": loc,
                    "date": date,
                    "url": link,
                    "score": score(title, "", [loc]),
                }
            )
            if len(jobs) >= limit:
                return jobs
        time.sleep(1)
    return jobs


def remotive(query: str, limit: int, days: int) -> list[dict]:
    data = json.loads(fetch("https://remotive.com/api/remote-jobs?search=" + urllib.parse.quote(query) + "&limit=50"))
    jobs = []
    for item in data.get("jobs", []):
        title = item.get("title", "")
        description = clean(item.get("description", ""))[:2000]
        date = parse_date(item.get("publication_date", ""))
        if not recent(date, days):
            continue
        jobs.append(
            {
                "source": "remotive",
                "title": title,
                "company": item.get("company_name", ""),
                "location": item.get("candidate_required_location", "Remote"),
                "date": date,
                "url": item.get("url", ""),
                "score": score(title, description, item.get("tags", [])),
            }
        )
        if len(jobs) >= limit:
            break
    return jobs


def remoteok(query: str, limit: int, days: int) -> list[dict]:
    data = json.loads(fetch("https://remoteok.com/api?tags=" + urllib.parse.quote(query.replace(" ", "-"))))
    jobs = []
    for item in data:
        if not isinstance(item, dict) or "position" not in item:
            continue
        title = item.get("position", "")
        description = clean(item.get("description", ""))[:2000]
        date = parse_date(str(item.get("date", "")))
        if not recent(date, days):
            continue
        jobs.append(
            {
                "source": "remoteok",
                "title": title,
                "company": item.get("company", ""),
                "location": item.get("location", "Remote"),
                "date": date,
                "url": item.get("url") or f"https://remoteok.com/remote-jobs/{item.get('id', '')}",
                "score": score(title, description, item.get("tags", [])),
            }
        )
        if len(jobs) >= limit:
            break
    return jobs


def wwr(query: str, limit: int, days: int) -> list[dict]:
    feeds = [
        "https://weworkremotely.com/categories/remote-devops-sysadmin-jobs.rss",
        "https://weworkremotely.com/categories/remote-programming-jobs.rss",
    ]
    jobs = []
    for feed in feeds:
        root = ET.fromstring(fetch(feed))
        for item in root.findall("./channel/item"):
            title = (item.findtext("title") or "").strip()
            region = (item.findtext("region") or "Remote").strip()
            description = clean(item.findtext("description") or "")[:2000]
            date = parse_date((item.findtext("pubDate") or "").strip())
            if not recent(date, days):
                continue
            jobs.append(
                {
                    "source": "weworkremotely",
                    "title": title,
                    "company": "",
                    "location": region,
                    "date": date,
                    "url": (item.findtext("link") or "").strip(),
                    "score": score(title, description, []),
                }
            )
            if len(jobs) >= limit:
                return jobs
    return jobs


class SourceUnavailable(RuntimeError):
    pass


def api_keys() -> dict[str, str]:
    keys = dict(os.environ)
    path = Path.home() / ".hermes/vagas/api.env"
    if path.is_file():
        for line in path.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            keys[key.strip()] = value.strip().strip('"').strip("'")
    return keys


def linkedin_browser(query: str, location: str, limit: int, days: int) -> list[dict]:
    try:
        from websockets.sync.client import connect
    except ImportError as exc:
        raise SourceUnavailable("sem python3-websockets") from exc

    cdp = os.environ.get("HERMES_BROWSER_CDP", "http://100.89.110.97:30922").rstrip("/")
    target = "https://www.linkedin.com/jobs/search?" + urllib.parse.urlencode(
        {"keywords": query, "location": location, "f_TPR": f"r{days * 86400}"}
    )
    request = urllib.request.Request(
        cdp + "/json/new?" + urllib.parse.quote(target, safe=""), method="PUT"
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        info = json.load(response)

    def call(ws, ident: int, method: str, params: dict | None = None) -> dict:
        ws.send(json.dumps({"id": ident, "method": method, "params": params or {}}))
        while True:
            message = json.loads(ws.recv(timeout=45))
            if message.get("id") == ident:
                return message

    expression = r"""(() => {
      const seen = new Set();
      const out = [];
      for (const a of document.querySelectorAll('a[href*="/jobs/view/"]')) {
        const url = a.href.split('?')[0];
        if (seen.has(url)) continue;
        seen.add(url);
        const card = a.closest('li') || a.parentElement;
        const pick = (sel) => {
          const el = card && card.querySelector(sel);
          return el ? el.innerText.trim() : "";
        };
        const title = pick('.base-search-card__title, .job-card-list__title, .job-card-container__link')
          || (a.innerText || '').trim();
        const company = pick('.base-search-card__subtitle, .job-card-container__company-name, .job-card-container__primary-description');
        const location = pick('.job-search-card__location, .job-card-container__metadata-item');
        out.push({url, title, company, location});
      }
      return JSON.stringify(out);
    })()"""

    try:
        with connect(info["webSocketDebuggerUrl"], open_timeout=15, close_timeout=5) as ws:
            call(ws, 1, "Page.enable")
            call(ws, 2, "Page.navigate", {"url": target})
            time.sleep(8)
            result = call(
                ws,
                3,
                "Runtime.evaluate",
                {"expression": expression, "returnByValue": True},
            )
            raw = result.get("result", {}).get("result", {}).get("value") or "[]"
            items = json.loads(raw)
    finally:
        try:
            urllib.request.urlopen(cdp + "/json/close/" + info["id"], timeout=10).read()
        except Exception:
            pass

    jobs = []
    for item in items[:limit]:
        title = item.get("title", "")
        url = item.get("url", "")
        if not title or not url:
            continue
        jobs.append(
            {
                "source": "linkedin-browser",
                "title": title,
                "company": item.get("company", ""),
                "location": item.get("location", ""),
                "date": "",
                "url": url,
                "score": score(title, "", [item.get("location", "")]),
            }
        )
    return jobs


def adzuna(query: str, location: str, limit: int, days: int) -> list[dict]:
    keys = api_keys()
    app_id = keys.get("ADZUNA_APP_ID")
    app_key = keys.get("ADZUNA_APP_KEY")
    if not app_id or not app_key:
        raise SourceUnavailable("sem ADZUNA_APP_ID/ADZUNA_APP_KEY")
    country = keys.get("ADZUNA_COUNTRY", "br")
    params = {
        "app_id": app_id,
        "app_key": app_key,
        "results_per_page": limit,
        "what": query,
        "max_days_old": days,
    }
    if location and location.lower() not in ("brazil", "brasil", "remote", "remoto"):
        params["where"] = location
    data = json.loads(fetch(f"https://api.adzuna.com/v1/api/jobs/{country}/search/1?{urllib.parse.urlencode(params)}"))
    jobs = []
    for item in data.get("results", []):
        title = item.get("title", "")
        company = (item.get("company") or {}).get("display_name", "")
        loc = (item.get("location") or {}).get("display_name", "")
        jobs.append(
            {
                "source": "adzuna",
                "title": title,
                "company": company,
                "location": loc,
                "date": parse_date(item.get("created", "")),
                "url": item.get("redirect_url", ""),
                "score": score(title, item.get("description", ""), [loc]),
            }
        )
    return jobs


def jooble(query: str, location: str, limit: int, days: int) -> list[dict]:
    key = api_keys().get("JOOBLE_KEY")
    if not key:
        raise SourceUnavailable("sem JOOBLE_KEY")
    payload = json.dumps({"keywords": query, "location": location}).encode()
    request = urllib.request.Request(
        "https://jooble.org/api/" + key,
        data=payload,
        headers={"Content-Type": "application/json", "User-Agent": UA},
    )
    with urllib.request.urlopen(request, timeout=25) as response:
        data = json.load(response)
    jobs = []
    for item in data.get("jobs", [])[:limit]:
        title = item.get("title", "")
        loc = item.get("location", "")
        jobs.append(
            {
                "source": "jooble",
                "title": title,
                "company": item.get("company", ""),
                "location": loc,
                "date": parse_date(item.get("updated", "")),
                "url": item.get("link", ""),
                "score": score(title, item.get("snippet", ""), [loc]),
            }
        )
    return jobs


def serpapi(query: str, location: str, limit: int, days: int) -> list[dict]:
    key = api_keys().get("SERPAPI_KEY")
    if not key:
        raise SourceUnavailable("sem SERPAPI_KEY")
    params = {
        "engine": "google_jobs",
        "q": query,
        "location": location,
        "api_key": key,
        "hl": "pt",
        "gl": "br",
    }
    data = json.loads(fetch("https://serpapi.com/search.json?" + urllib.parse.urlencode(params)))
    jobs = []
    for item in data.get("jobs_results", [])[:limit]:
        title = item.get("title", "")
        loc = item.get("location", "")
        via = item.get("via", "")
        options = item.get("apply_options") or []
        url = item.get("share_link") or (options[0].get("link") if options else "")
        jobs.append(
            {
                "source": "serpapi",
                "title": title,
                "company": item.get("company_name", "") + (f" ({via})" if via else ""),
                "location": loc,
                "date": "",
                "url": url,
                "score": score(title, item.get("description", ""), [loc, via]),
            }
        )
    return jobs


def render_markdown(query: str, location: str, jobs: list[dict], errors: list[str]) -> str:
    lines = [
        f"# Vagas: {query}" + (f" em {location}" if location else ""),
        "",
        f"Gerado em {datetime.now().strftime('%Y-%m-%d %H:%M')}.",
        "",
    ]
    if errors:
        lines.append("Fontes indisponiveis: " + ", ".join(errors))
        lines.append("")
    if not jobs:
        lines.append("Nenhuma vaga encontrada nas fontes consultadas.")
        return "\n".join(lines) + "\n"
    for job in jobs:
        lines.append(f"## {job['title']}")
        meta = [job.get("company") or "", job.get("location") or "", job.get("source") or "", job.get("date") or ""]
        lines.append(" | ".join([m for m in meta if m]))
        lines.append(f"- link: {job['url']}")
        lines.append(f"- score: {job['score']}")
        lines.append("")
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description="Busca vagas em fontes publicas.")
    parser.add_argument("query", help="cargo ou palavras-chave")
    parser.add_argument("--location", default="Brazil", help="local para o LinkedIn")
    parser.add_argument("--limit", type=int, default=10, help="maximo por fonte")
    parser.add_argument("--days", type=int, default=21, help="janela em dias")
    parser.add_argument(
        "--sources",
        default="linkedin,remotive,remoteok,wwr",
        help="linkedin, linkedin-browser, remotive, remoteok, wwr, adzuna, jooble, serpapi",
    )
    parser.add_argument("--json", action="store_true", help="saida JSON")
    parser.add_argument("--out", help="arquivo para salvar o Markdown")
    args = parser.parse_args()

    sources = {s.strip().lower() for s in args.sources.split(",") if s.strip()}
    jobs: list[dict] = []
    errors: list[str] = []
    for name, func in (
        ("linkedin", lambda: linkedin(args.query, args.location, args.limit, args.days)),
        ("linkedin-browser", lambda: linkedin_browser(args.query, args.location, args.limit, args.days)),
        ("remotive", lambda: remotive(args.query, args.limit, args.days)),
        ("remoteok", lambda: remoteok(args.query, args.limit, args.days)),
        ("wwr", lambda: wwr(args.query, args.limit, args.days)),
        ("adzuna", lambda: adzuna(args.query, args.location, args.limit, args.days)),
        ("jooble", lambda: jooble(args.query, args.location, args.limit, args.days)),
        ("serpapi", lambda: serpapi(args.query, args.location, args.limit, args.days)),
    ):
        if name not in sources:
            continue
        try:
            jobs.extend(func())
        except SourceUnavailable as exc:
            errors.append(f"{name} ({exc})")
        except Exception as exc:  # noqa: BLE001
            errors.append(f"{name} ({type(exc).__name__})")

    unique: dict[str, dict] = {}
    for job in jobs:
        key = job.get("url") or f"{job.get('title')}|{job.get('company')}"
        if key and key not in unique:
            unique[key] = job
    jobs = sorted(unique.values(), key=lambda j: (j["score"], j.get("date") or ""), reverse=True)

    if args.json:
        output = json.dumps({"query": args.query, "errors": errors, "jobs": jobs}, ensure_ascii=False, indent=2)
    else:
        output = render_markdown(args.query, args.location, jobs, errors)

    if args.out:
        with open(args.out, "w", encoding="utf-8") as handle:
            handle.write(output)
        print(f"{len(jobs)} vagas salvas em {args.out}")
    else:
        print(output)
    return 0 if jobs else 1


if __name__ == "__main__":
    raise SystemExit(main())
