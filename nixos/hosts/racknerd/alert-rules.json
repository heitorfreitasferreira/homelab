{
  "groups": [
    {
      "name": "watchdog",
      "rules": [
        {
          "alert": "Watchdog",
          "expr": "vector(1)",
          "labels": {
            "severity": "none"
          },
          "annotations": {
            "summary": "Pipeline de alertas vivo"
          }
        }
      ]
    },
    {
      "name": "hosts",
      "rules": [
        {
          "alert": "AlvoFora",
          "expr": "up{instance!~\"100\\\\.89\\\\.110\\\\.97:.*|pc-heito-wsl\",node!=\"pc-heito-wsl\"} == 0",
          "for": "3m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "{{ $labels.job }} ({{ $labels.instance }}) sem resposta ha 3 min"
          }
        },
        {
          "alert": "MemoriaBaixa",
          "expr": "node_memory_MemAvailable_bytes{node!~\"pc-heito-wsl|casa\"} / node_memory_MemTotal_bytes{node!~\"pc-heito-wsl|casa\"} < 0.10",
          "for": "10m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.instance }}: {{ $value | humanizePercentage }} de RAM livre"
          }
        },
        {
          "alert": "DiscoQuaseCheio",
          "expr": "node_filesystem_avail_bytes{fstype=~\"ext4|xfs|btrfs\",mountpoint!~\"/usr/src.*\",node!=\"pc-heito-wsl\"} / node_filesystem_size_bytes{fstype=~\"ext4|xfs|btrfs\",mountpoint!~\"/usr/src.*\",node!=\"pc-heito-wsl\"} < 0.10 and on(instance, device, mountpoint) node_filesystem_size_bytes{node!=\"pc-heito-wsl\"} > 1e9",
          "for": "15m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.instance }} {{ $labels.mountpoint }}: {{ $value | humanizePercentage }} livre"
          }
        },
        {
          "alert": "TemperaturaAlta",
          "expr": "max by (instance) (node_hwmon_temp_celsius{node!=\"pc-heito-wsl\"}) > 85",
          "for": "10m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.instance }} a {{ $value }} C"
          }
        },
        {
          "alert": "InterfaceDoCaboFora",
          "expr": "node_network_up{instance=\"casa\", device=\"enp2s0f5\"} == 0 or absent(node_network_up{instance=\"casa\", device=\"enp2s0f5\"})",
          "for": "5m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "casa sem a placa enp2s0f5 (o cabo caiu ou a placa mudou de nome)"
          }
        }
      ]
    },
    {
      "name": "sondas",
      "rules": [
        {
          "alert": "SiteFora",
          "expr": "probe_success{job=\"probe-https\"} == 0",
          "for": "3m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "{{ $labels.instance }} fora do ar"
          }
        },
        {
          "alert": "DNSDaTailnetFora",
          "expr": "probe_success{job=\"probe-dns\"} == 0",
          "for": "2m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "Pi-hole do racknerd nao responde: a tailnet esta sem DNS"
          }
        },
        {
          "alert": "SiteLento",
          "expr": "avg_over_time(probe_duration_seconds{job=\"probe-https\"}[5m]) > 5 and probe_success{job=\"probe-https\"} == 1",
          "for": "10m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.instance }}: resposta em {{ $value | printf \"%.1f\" }} s"
          }
        },
        {
          "alert": "CertificadoVencendo",
          "expr": "(probe_ssl_earliest_cert_expiry - time()) / 86400 < 10",
          "for": "1h",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.instance }}: certificado vence em {{ $value | printf \"%.0f\" }} dias"
          }
        }
      ]
    },
    {
      "name": "casa",
      "rules": [
        {
          "alert": "CasaNaBateria",
          "expr": "node_power_supply_online{instance=\"casa\",power_supply=\"AC0\"} == 0",
          "for": "1m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "casa esta na bateria: a tomada caiu e o notebook desliga em minutos"
          }
        },
        {
          "alert": "CasaCpuAlta",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{instance=\"casa\",mode=\"idle\"}[5m]))) > 95",
          "for": "15m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: CPU em {{ $value | printf \"%.0f\" }}% por 15 min"
          }
        },
        {
          "alert": "CasaSwapQuaseCheia",
          "expr": "(node_memory_SwapTotal_bytes{instance=\"casa\"} - node_memory_SwapFree_bytes{instance=\"casa\"}) / node_memory_SwapTotal_bytes{instance=\"casa\"} > 0.8",
          "for": "15m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: swap/zram em {{ $value | humanizePercentage }}"
          }
        },
        {
          "alert": "CasaOOM",
          "expr": "increase(node_vmstat_oom_kill{instance=\"casa\"}[10m]) > 0",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "casa matou processo por falta de memoria (OOM) nos ultimos 10 min"
          }
        },
        {
          "alert": "CasaDiscoSomenteLeitura",
          "expr": "node_filesystem_readonly{instance=\"casa\",fstype=~\"ext4|xfs|btrfs\"} == 1",
          "for": "5m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "casa: {{ $labels.mountpoint }} esta somente leitura"
          }
        },
        {
          "alert": "CasaInodesQuaseCheios",
          "expr": "node_filesystem_files_free{instance=\"casa\",fstype=~\"ext4|xfs\"} / node_filesystem_files{instance=\"casa\",fstype=~\"ext4|xfs\"} < 0.10",
          "for": "15m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: {{ $labels.mountpoint }} com {{ $value | humanizePercentage }} de inodes livres"
          }
        },
        {
          "alert": "CasaDiscoLento",
          "expr": "rate(node_disk_io_time_seconds_total{instance=\"casa\",device=\"sda\"}[5m]) > 0.8",
          "for": "15m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: disco ocupado mais de 80% do tempo"
          }
        },
        {
          "alert": "CasaDiscoSmartFalha",
          "expr": "smartmon_device_smart_healthy{instance=\"casa\"} == 0",
          "for": "5m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "casa: SMART do {{ $labels.disk }} reprovou a saude do disco"
          }
        },
        {
          "alert": "CasaDiscoSetorPendente",
          "expr": "smartmon_current_pending_sector_raw_value{instance=\"casa\"} > 0",
          "for": "5m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: {{ $labels.disk }} tem setores pendentes de realocacao"
          }
        },
        {
          "alert": "CasaDiscoRealocado",
          "expr": "delta(smartmon_reallocated_sector_ct_raw_value{instance=\"casa\"}[24h]) > 0",
          "for": "15m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: {{ $labels.disk }} realocou setores nas ultimas 24 h"
          }
        },
        {
          "alert": "CasaDiscoCrc",
          "expr": "delta(smartmon_udma_crc_error_count_raw_value{instance=\"casa\"}[24h]) > 0",
          "for": "15m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: {{ $labels.disk }} teve erro de CRC nas ultimas 24 h (cabo ou controladora)"
          }
        },
        {
          "alert": "CasaDiscoQuente",
          "expr": "max(smartmon_temperature_celsius_raw_value{instance=\"casa\"}) > 50",
          "for": "15m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: disco a {{ $value | printf \"%.0f\" }} C"
          }
        },
        {
          "alert": "CasaServicoFora",
          "expr": "node_systemd_unit_state{instance=\"casa\",name=~\"homeassistant.service|matterhub.service|tailscaled.service|prometheus-node-exporter.service|nftables.service|ssh.service|smartmontools.service|thermald.service\",state=\"active\"} == 0",
          "for": "10m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: {{ $labels.name }} nao esta ativo"
          }
        },
        {
          "alert": "CasaWatchdogAusente",
          "expr": "absent(node_watchdog_timeleft_seconds{instance=\"casa\"}) == 1 and on() up{job=\"node\",instance=\"casa\"} == 1",
          "for": "1h",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: watchdog de hardware sumiu do node-exporter"
          }
        },
        {
          "alert": "CasaRelogioFora",
          "expr": "abs(node_timex_offset_seconds{instance=\"casa\"}) > 1",
          "for": "10m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: relogio {{ $value | printf \"%.1f\" }} s fora do NTP"
          }
        },
        {
          "alert": "CasaSemSyncNtp",
          "expr": "node_timex_sync_status{instance=\"casa\"} == 0",
          "for": "15m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: systemd-timesyncd nao sincronizou o relogio"
          }
        },
        {
          "alert": "CasaRebootPendente",
          "expr": "node_reboot_required{instance=\"casa\"} == 1",
          "for": "24h",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: atualizacao pediu reboot ha mais de 24 h"
          }
        }
      ]
    },
    {
      "name": "tailscale",
      "rules": [
        {
          "alert": "TailscaleColetorFalhou",
          "expr": "tailscale_exporter_success{instance=\"casa\"} == 0",
          "for": "30m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: o coletor de metricas do Tailscale falhou"
          }
        },
        {
          "alert": "TailscaleMetricasParadas",
          "expr": "time() - node_textfile_mtime_seconds{instance=\"casa\",file=\"/var/lib/prometheus/node-exporter/tailscale.prom\"} > 300",
          "for": "5m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: metricas do Tailscale paradas ha mais de 5 min"
          }
        },
        {
          "alert": "TailscaleMetricasSumiram",
          "expr": "absent(tailscale_up{instance=\"casa\"}) == 1 and on() up{job=\"node\",instance=\"casa\"} == 1",
          "for": "30m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "casa: metricas do Tailscale sumiram do node-exporter"
          }
        },
        {
          "alert": "TailscaleRacknerdFora",
          "expr": "tailscale_peer_online{instance=\"casa\",peer=\"racknerd\"} == 0",
          "for": "10m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Tailscale do racknerd offline para o casa"
          }
        },
        {
          "alert": "TailscaleRacknerdHostFora",
          "expr": "tailscale_up{instance=\"racknerd\"} == 0",
          "for": "5m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "tailscaled do racknerd nao responde"
          }
        },
        {
          "alert": "TailscaleChaveVencendo",
          "expr": "(tailscale_peer_key_expiry_timestamp_seconds{instance=\"casa\"} - time()) / 86400 < 14",
          "for": "1h",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "{{ $labels.peer }}: chave do Tailscale vence em {{ $value | printf \"%.0f\" }} dias"
          }
        },
        {
          "alert": "TailscaleCasaEmRelay",
          "expr": "tailscale_peer_direct{instance=\"casa\",peer=\"racknerd\"} == 0 and tailscale_peer_online{instance=\"casa\",peer=\"racknerd\"} == 1",
          "for": "2h",
          "labels": {
            "severity": "info"
          },
          "annotations": {
            "summary": "casa fala com o racknerd via DERP ha 2 h"
          }
        }
      ]
    },
    {
      "name": "pipeline",
      "rules": [
        {
          "alert": "NotificacaoFalhou",
          "expr": "sum by (integration) (increase(alertmanager_notifications_failed_total[15m])) > 0",
          "for": "5m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "Alertmanager: {{ $value | printf \"%.0f\" }} falhas em {{ $labels.integration }}"
          }
        }
      ]
    },
    {
      "name": "banco",
      "rules": [
        {
          "alert": "ArquivamentoFalhou",
          "expr": "time() - pg_archiver_last_failed_timestamp_seconds < 3600",
          "for": "5m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "racknerd: o arquivamento do WAL falhou na ultima hora, o restore para no ultimo segmento no R2"
          }
        },
        {
          "alert": "WalAcumulando",
          "expr": "pg_wal_bytes > 8e9",
          "for": "30m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "racknerd: pg_wal acima de 8 GB, o arquivamento nao esta dando conta"
          }
        }
      ]
    },
    {
      "name": "racknerd",
      "rules": [
        {
          "alert": "ServicoFora",
          "expr": "node_systemd_unit_state{instance=\"racknerd\",name=~\"podman-nextcloud\\\\.service|podman-securo-backend\\\\.service|podman-securo-worker\\\\.service|podman-securo-frontend\\\\.service|podman-securo-mcp\\\\.service|podman-waha\\\\.service|podman-pihole\\\\.service|podman-audiobookshelf\\\\.service|podman-readmeabook\\\\.service|podman-prowlarr\\\\.service|podman-transmission\\\\.service|podman-homepage\\\\.service|postgresql\\\\.service|caddy\\\\.service|tailscaled\\\\.service|hermes-gateway\\\\.service|opencode\\\\.service|victoriametrics\\\\.service|grafana\\\\.service|alertmanager\\\\.service|comin\\\\.service\",state=\"active\"} == 0",
          "for": "5m",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "racknerd: {{ $labels.name }} parado ha 5 min"
          }
        },
        {
          "alert": "UnidadeFalhou",
          "expr": "node_systemd_unit_state{instance=\"racknerd\",state=\"failed\"} == 1",
          "for": "5m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "racknerd: {{ $labels.name }} em failed"
          }
        },
        {
          "alert": "BackupAtrasado",
          "expr": "(time() - node_systemd_timer_last_trigger_seconds{instance=\"racknerd\",name=~\"restic-backups-r2.timer|wal-g-backup.timer\"}) > 36 * 3600",
          "for": "30m",
          "labels": {
            "severity": "warning"
          },
          "annotations": {
            "summary": "racknerd: {{ $labels.name }} sem rodar ha mais de 36 h"
          }
        }
      ]
    }
  ]
}
