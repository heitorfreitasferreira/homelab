#!/usr/bin/env python3
"""Troca secrets vazados nos arquivos sops do repo, lendo os valores novos sem eco no terminal.

Uso:
  nixos/scripts/rotacionar r2            token R2 de backups (ACCESS_KEY_ID e ACCESS_SECRET_KEY)
  nixos/scripts/rotacionar healthchecks  URL de ping do Healthchecks do Watchdog

Atualiza os Secrets do cluster (enquanto o k3s existir) e nixos/secrets/racknerd.sops.yaml.
Nada e impresso alem dos nomes das chaves trocadas.
Precisa de sops (ou SOPS=/caminho) e da chave age em SOPS_AGE_KEY_FILE.
"""
import getpass
import os
import re
import subprocess
import sys

import yaml

SOPS = os.environ.get("SOPS", "sops")
NIXOS = "nixos/secrets/racknerd.sops.yaml"


def decrypt(path):
    out = subprocess.run([SOPS, "-d", path], capture_output=True, text=True, check=True).stdout
    return yaml.safe_load(out)


def encrypt(path, data):
    plain = f"/dev/shm/rotacionar-{os.getpid()}.yaml"
    fd = os.open(plain, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            yaml.safe_dump(data, f, sort_keys=False, default_flow_style=False, allow_unicode=True)
        enc = subprocess.run(
            [SOPS, "-e", "--filename-override", path, "--input-type", "yaml", "--output-type", "yaml", plain],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    finally:
        os.remove(plain)
    with open(path, "w") as f:
        f.write(enc)


def ask(label, pattern):
    value = getpass.getpass(f"{label}: ").strip()
    if not re.fullmatch(pattern, value):
        sys.exit(f"{label}: formato inesperado, nada foi alterado")
    return value


def r2():
    key_id = ask("Access Key ID do token novo", r"[0-9a-f]{32}")
    secret = ask("Secret Access Key do token novo", r"[0-9a-f]{64}")
    for path in ("apps/nextcloud/r2-backups.sops.yaml", "apps/securo-backup/r2-backups.sops.yaml"):
        d = decrypt(path)
        d["stringData"]["ACCESS_KEY_ID"] = key_id
        d["stringData"]["ACCESS_SECRET_KEY"] = secret
        encrypt(path, d)
        print(f"{path}: ACCESS_KEY_ID, ACCESS_SECRET_KEY")
    d = decrypt(NIXOS)
    d["r2_backups_access_key_id"] = key_id
    d["r2_backups_secret_access_key"] = secret
    encrypt(NIXOS, d)
    print(f"{NIXOS}: r2_backups_access_key_id, r2_backups_secret_access_key")


def healthchecks():
    url = ask("URL de ping nova", r"https://hc-ping\.com/[0-9a-f-]{36}")
    path = "apps/monitoring/alertmanager-config.sops.yaml"
    d = decrypt(path)
    cfg = yaml.safe_load(d["stringData"]["alertmanager.yaml"])
    hooks = [r for r in cfg["receivers"] if r["name"] == "healthchecks"][0]["webhook_configs"]
    hooks[0]["url"] = url
    d["stringData"]["alertmanager.yaml"] = yaml.safe_dump(cfg, sort_keys=False, allow_unicode=True)
    encrypt(path, d)
    print(f"{path}: receivers.healthchecks.url")
    d = decrypt(NIXOS)
    d["alertmanager_healthchecks_url"] = url
    encrypt(NIXOS, d)
    print(f"{NIXOS}: alertmanager_healthchecks_url")


if __name__ == "__main__":
    if len(sys.argv) != 2 or sys.argv[1] not in ("r2", "healthchecks"):
        print(__doc__, file=sys.stderr)
        sys.exit(2)
    os.chdir(subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True).stdout.strip())
    {"r2": r2, "healthchecks": healthchecks}[sys.argv[1]]()
