#!/usr/bin/env python3
"""Adiciona ou troca um secret gerado (aleatorio, alfanumerico) num arquivo sops sem exibi-lo.

Uso: nixos/scripts/secret-gen <arquivo.sops.yaml> <chave> [tamanho]
Exemplo: nixos/scripts/secret-gen nixos/secrets/racknerd.sops.yaml grafana_secret_key 40
Precisa de sops no PATH (ou SOPS=/caminho) e da chave age em SOPS_AGE_KEY_FILE.
"""
import os
import secrets
import string
import subprocess
import sys

import yaml


def main() -> int:
    if len(sys.argv) not in (3, 4):
        print(__doc__, file=sys.stderr)
        return 2
    path, key = sys.argv[1], sys.argv[2]
    size = int(sys.argv[3]) if len(sys.argv) == 4 else 40
    if size < 16:
        print("tamanho minimo: 16", file=sys.stderr)
        return 2
    sops = os.environ.get("SOPS", "sops")
    data = yaml.safe_load(subprocess.run([sops, "-d", path], capture_output=True, text=True, check=True).stdout) or {}
    alphabet = string.ascii_letters + string.digits
    data[key] = "".join(secrets.choice(alphabet) for _ in range(size))
    plain = f"/dev/shm/secret-gen-{os.getpid()}.yaml"
    fd = os.open(plain, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            yaml.safe_dump(data, f)
        enc = subprocess.run(
            [sops, "-e", "--filename-override", path, "--input-type", "yaml", "--output-type", "yaml", plain],
            capture_output=True,
            text=True,
            check=True,
        ).stdout
    finally:
        os.remove(plain)
    with open(path, "w") as f:
        f.write(enc)
    print(f"{key}: gerado ({size} caracteres), {len(data)} chaves no arquivo")
    return 0


if __name__ == "__main__":
    sys.exit(main())
