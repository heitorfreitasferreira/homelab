// Tailscale policy (copy of what is saved in the admin console, Access controls).
// tag:k8s-operator: the Tailscale Kubernetes operator. tag:k8s: the proxies it creates per service.
// tag:server: hosts NixOS (racknerd) que servem os Tailscale Services depois da migracao do k3s.
{
	"tagOwners": {
		"tag:k8s-operator": [],
		"tag:k8s":          ["tag:k8s-operator"],
		"tag:server":       ["autogroup:admin"],
	},

	"grants": [
		// Allow all connections between my devices and the cluster services.
		{"src": ["*"], "dst": ["*"], "ip": ["*"]},
	],

	// Hosts com tag:server podem servir estes servicos sem aprovacao manual.
	"autoApprovers": {
		"services": {
			"svc:grafana":    ["tag:server"],
			"svc:home":       ["tag:server"],
			"svc:pihole":     ["tag:server"],
			"svc:waha":       ["tag:server"],
			"svc:prowlarr":   ["tag:server"],
			"svc:transmission":["tag:server"],
			"svc:metricas":   ["tag:server"],
			"svc:securo-mcp": ["tag:server"],
		},
	},

	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// Servidores com tag nao sao "self": regra propria para eles.
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["tag:server"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
