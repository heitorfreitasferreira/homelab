#!/usr/bin/env bash
# Operacoes rotineiras do homelab para o Hermes.
# A copia que vale e a instalada em /usr/local/sbin/hermes-ops, root-owned.
# O fonte fica no repo para revisao. Nao edite o host no meio de um incidente.
set -euo pipefail

REPO="${HERMES_OPS_REPO:-/home/htr/homelab}"
ARGOCD_NS="argocd"
METRICS="${HERMES_OPS_METRICS:-https://metricas.tail76c1c6.ts.net}"
RESTART_NAMESPACES="monitoring homepage hermes nextcloud securo pihole"
KUBECTL=(sudo -n k3s kubectl)

die() {
    echo "erro: $*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
uso: hermes-ops <comando> [argumentos]

Comandos:
  status
      Nos, apps do Argo, pods fora de Running, alertas firing e recursos do host.

  sync <app>
      Pede refresh e sync da Application no Argo e espera o estado.

  logs <namespace> <pod> [linhas]
      Log do pod, padrao 120 linhas.

  restart <namespace> <deployment>
      Rollout restart e espera o rollout. Namespaces permitidos:
      monitoring, homepage, hermes, nextcloud, securo, pihole.

  publish "<mensagem>"
      git pull --ff-only, valida arquivos, commit e push pela deploy key.

  revert <sha>
      Cria um commit de revert de um commit que esta no historico e faz push.

  help
      Esta ajuda.
EOF
}

require_name() {
    local value="${1:-}"
    [[ "$value" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || die "nome invalido: $value"
}

require_app() {
    local app="${1:-}"
    [[ -n "$app" ]] || die "uso: hermes-ops sync <app>"
    require_name "$app"
    "${KUBECTL[@]}" -n "$ARGOCD_NS" get application "$app" >/dev/null 2>&1 \
        || die "application nao encontrada: $app"
}

cmd_status() {
    echo "== nos"
    "${KUBECTL[@]}" get nodes -o wide

    echo
    echo "== argo"
    "${KUBECTL[@]}" -n "$ARGOCD_NS" get applications \
        -o custom-columns='APP:.metadata.name,SYNC:.status.sync.status,HEALTH:.status.health.status' \
        --sort-by=.metadata.name

    echo
    echo "== pods fora de Running"
    "${KUBECTL[@]}" get pods -A --no-headers \
        | awk '$4 != "Running" && $4 != "Completed" {print}' \
        | sed 's/^/  /' || true

    echo
    echo "== alertas firing"
    local alert_json
    if alert_json=$(curl -fsS --max-time 15 -G "$METRICS/api/v1/query" \
        --data-urlencode 'query=ALERTS{alertstate="firing",alertname!="Watchdog"}'); then
        printf '%s' "$alert_json" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print("resposta invalida do vmsingle")
    raise SystemExit(0)
rows = data.get("data", {}).get("result", [])
if not rows:
    print("nenhum")
for row in rows:
    m = row.get("metric", {})
    print(m.get("alertname", "?"), m.get("severity", ""), m.get("instance", ""), m.get("node", ""))
'
    else
        echo "consulta indisponivel"
    fi

    echo
    echo "== host"
    free -m | awk 'NR <= 2'
    df -h / | tail -n 1
}

cmd_sync() {
    local app="${1:-}"
    require_app "$app"

    echo "refresh $app"
    "${KUBECTL[@]}" -n "$ARGOCD_NS" annotate application "$app" \
        argocd.argoproj.io/refresh=hard --overwrite >/dev/null

    local i sync health
    sync=""
    health=""
    for i in $(seq 1 36); do
        sync=$("${KUBECTL[@]}" -n "$ARGOCD_NS" get application "$app" \
            -o jsonpath='{.status.sync.status}' 2>/dev/null || true)
        health=$("${KUBECTL[@]}" -n "$ARGOCD_NS" get application "$app" \
            -o jsonpath='{.status.health.status}' 2>/dev/null || true)
        echo "  tentativa $i sync=${sync:-?} health=${health:-?}"
        if [[ "$sync" == "Synced" && -n "$health" ]]; then
            break
        fi
        sleep 5
    done

    if [[ "$sync" != "Synced" ]]; then
        echo "ainda OutOfSync, disparando sync explicito"
        "${KUBECTL[@]}" -n "$ARGOCD_NS" patch application "$app" --type merge \
            -p '{"operation":{"sync":{}}}' >/dev/null || true
        for i in $(seq 1 24); do
            sync=$("${KUBECTL[@]}" -n "$ARGOCD_NS" get application "$app" \
                -o jsonpath='{.status.sync.status}' 2>/dev/null || true)
            health=$("${KUBECTL[@]}" -n "$ARGOCD_NS" get application "$app" \
                -o jsonpath='{.status.health.status}' 2>/dev/null || true)
            echo "  tentativa $i sync=${sync:-?} health=${health:-?}"
            [[ "$sync" == "Synced" && -n "$health" ]] && break
            sleep 5
        done
    fi

    [[ "$sync" == "Synced" ]] || die "sync nao concluiu para $app"
    echo "ok: $app sync=Synced health=${health:-?}"
    if [[ "$health" == "Degraded" ]]; then
        echo "aviso: $app esta Degraded, leia os eventos antes de seguir" >&2
        exit 2
    fi
}

cmd_logs() {
    local ns="${1:-}" pod="${2:-}" lines="${3:-120}"
    [[ -n "$ns" && -n "$pod" ]] || die "uso: hermes-ops logs <namespace> <pod> [linhas]"
    require_name "$ns"
    require_name "$pod"
    [[ "$lines" =~ ^[0-9]+$ ]] || die "linhas invalido: $lines"
    "${KUBECTL[@]}" -n "$ns" logs "$pod" --tail="$lines"
}

cmd_restart() {
    local ns="${1:-}" dep="${2:-}"
    [[ -n "$ns" && -n "$dep" ]] || die "uso: hermes-ops restart <namespace> <deployment>"
    require_name "$ns"
    require_name "$dep"
    case " $RESTART_NAMESPACES " in
        *" $ns "*) ;;
        *) die "namespace nao permitido para restart: $ns" ;;
    esac
    "${KUBECTL[@]}" -n "$ns" get deployment "$dep" >/dev/null 2>&1 \
        || die "deployment nao encontrado: $ns/$dep"
    "${KUBECTL[@]}" -n "$ns" rollout restart "deployment/$dep"
    "${KUBECTL[@]}" -n "$ns" rollout status "deployment/$dep" --timeout=180s
}

cmd_publish() {
    local msg="$*"
    [[ -n "$msg" ]] || die 'uso: hermes-ops publish "mensagem do commit"'
    [[ "$msg" != *$'\n'* ]] || die "mensagem nao pode ter quebra de linha"

    cd "$REPO"
    git pull --ff-only

    local changed bad
    changed=$(git status --porcelain | sed -E 's/^.. //' | sed 's/.* -> //')
    if [[ -z "$changed" ]]; then
        echo "nada para publicar"
        return 0
    fi

    bad=$(printf '%s\n' "$changed" | grep -E \
        '(^|/)\.env($|\.)|(^|/)id_(rsa|ed25519)(\.|$)|\.(pem|key|p12|pfx)$|(^|/)kubeconfig$|(^|/)\.kube/|(^|/)credentials(\.|$)' \
        || true)
    if [[ -n "$bad" ]]; then
        echo "recusado: arquivo com cara de segredo no commit" >&2
        printf '%s\n' "$bad" >&2
        return 1
    fi

    git add -A
    git commit -m "$msg"
    git push origin HEAD
    git log -1 --oneline
}

cmd_revert() {
    local sha="${1:-}"
    [[ "$sha" =~ ^[0-9a-f]{7,40}$ ]] || die "sha invalido: $sha"

    cd "$REPO"
    git pull --ff-only
    git cat-file -e "${sha}^{commit}" 2>/dev/null || die "commit nao existe: $sha"
    git merge-base --is-ancestor "$sha" HEAD || die "commit nao esta no historico do main"

    git revert --no-edit "$sha"
    git push origin HEAD
    git log -1 --oneline
}

main() {
    local command="${1:-help}"
    shift || true
    case "$command" in
        status) cmd_status ;;
        sync) cmd_sync "${1:-}" ;;
        logs) cmd_logs "${1:-}" "${2:-}" "${3:-120}" ;;
        restart) cmd_restart "${1:-}" "${2:-}" ;;
        publish) cmd_publish "$@" ;;
        revert) cmd_revert "${1:-}" ;;
        help | -h | --help) usage ;;
        *) usage >&2; exit 1 ;;
    esac
}

main "$@"
