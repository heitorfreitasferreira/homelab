    {
      "type": "table",
      "title": "Peers",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": null,
      "targets": [
        {
          "expr": "tailscale_peer_online{instance=\"casa\"}",
          "refId": "A",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "expr": "tailscale_peer_direct{instance=\"casa\"}",
          "refId": "B",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "expr": "rate(tailscale_peer_rx_bytes{instance=\"casa\"}[5m])",
          "refId": "C",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        },
        {
          "expr": "rate(tailscale_peer_tx_bytes{instance=\"casa\"}[5m])",
          "refId": "D",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "peer": "Peer",
              "os": "OS",
              "Value #A": "Online",
              "Value #B": "Direto",
              "Value #C": "RX/s",
              "Value #D": "TX/s"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Online"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "offline",
                        "color": "red"
                      },
                      "1": {
                        "text": "online",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Direto"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DERP",
                        "color": "yellow"
                      },
                      "1": {
                        "text": "direto",
                        "color": "green"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RX/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "binBps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "TX/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "binBps"
              }
            ]
          }
        ]
      },
