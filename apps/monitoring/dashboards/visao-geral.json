    {
      "type": "stat",
      "title": "Alvos fora",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "PC WSL é efêmero e não entra nesta contagem.",
      "targets": [
        {
          "expr": "sum(up{instance!~\"100\\\\.89\\\\.110\\\\.97:.*|pc-heito-wsl\",node!=\"pc-heito-wsl\",kubernetes_io_hostname!=\"pc-heito-wsl\"} == 0)",
          "refId": "A",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "id": 2,
