apiVersion: v1
kind: Namespace
metadata:
  name: argocd
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argo-cd
  namespace: kube-system
spec:
  repo: https://argoproj.github.io/argo-helm
  chart: argo-cd
  version: {{ argocd_chart_version }}
  targetNamespace: argocd
  valuesContent: |-
    # Lean single-node install: no Dex, no notifications, no HA.
    fullnameOverride: argocd
    dex:
      enabled: false
    notifications:
      enabled: false
    configs:
      params:
        server.insecure: true
      cm:
        kustomize.buildOptions: --enable-helm
    controller:
      resources:
        requests: {cpu: 100m, memory: 256Mi}
        limits: {memory: 768Mi}
    repoServer:
      resources:
        requests: {cpu: 50m, memory: 128Mi}
        limits: {memory: 512Mi}
    server:
      resources:
        requests: {cpu: 50m, memory: 64Mi}
        limits: {memory: 256Mi}
    applicationSet:
      resources:
        requests: {cpu: 20m, memory: 64Mi}
        limits: {memory: 192Mi}
    redis:
      resources:
        requests: {cpu: 20m, memory: 32Mi}
        limits: {memory: 128Mi}
