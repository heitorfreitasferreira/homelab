apiVersion: v1
kind: Namespace
metadata:
  name: argocd
---
apiVersion: helm.cattle.io/v1
kind: HelmChart
metadata:
  name: argo-cd
  namespace: kube-system
spec:
  repo: https://argoproj.github.io/argo-helm
  chart: argo-cd
  version: {{ argocd_chart_version }}
  targetNamespace: argocd
  valuesContent: |-
    # Lean single-node install: no Dex, no notifications, no HA.
    fullnameOverride: argocd
    dex:
      enabled: false
    notifications:
      enabled: false
    configs:
      params:
        server.insecure: true
      cm:
        # KSOPS runs as a kustomize exec plugin to decrypt *.sops.yaml with the age key.
        kustomize.buildOptions: --enable-alpha-plugins --enable-exec --enable-helm
    controller:
      resources:
        requests: {cpu: 100m, memory: 256Mi}
        limits: {memory: 768Mi}
    repoServer:
      resources:
        requests: {cpu: 50m, memory: 128Mi}
        limits: {memory: 512Mi}
      env:
        - name: XDG_CONFIG_HOME
          value: /.config
        - name: SOPS_AGE_KEY_FILE
          value: /.config/sops/age/keys.txt
        # ksops and its matching kustomize come first; the rest is the image default PATH.
        - name: PATH
          value: /opt/ksops:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      # ksops image is distroless (no shell to copy binaries), so it is mounted as an image volume.
      volumes:
        - name: ksops
          image:
            reference: viaductoss/ksops:{{ ksops_version }}
            pullPolicy: IfNotPresent
        - name: sops-age
          secret:
            secretName: sops-age
      volumeMounts:
        - mountPath: /opt/ksops
          name: ksops
          subPath: usr/local/bin
        - mountPath: /.config/sops/age
          name: sops-age
    server:
      resources:
        requests: {cpu: 50m, memory: 64Mi}
        limits: {memory: 256Mi}
    applicationSet:
      resources:
        requests: {cpu: 20m, memory: 64Mi}
        limits: {memory: 192Mi}
    redis:
      resources:
        requests: {cpu: 20m, memory: 32Mi}
        limits: {memory: 128Mi}
